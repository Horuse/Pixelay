// Pixelay: the screen cursor, drawn by the client every frame where the player looks.
//
// While a ScreenSession shows a shader cursor, the player's eyes are in client-side water, so the client draws
// the water overlay (textures/misc/underwater.png, replaced by Pixelay's cursor atlas) over the screen. Its
// texture coordinates move with the player's own look: -yaw / 64 and pitch / 64. The rest comes from the
// server through the world age (GameTime, negative while a cursor is shown): which sprite to draw and how
// wide the canvas looks. The plugin maps the look to the canvas pixel with the same formula.
//
// Needs pixelay_cursor_config.glsl (generated by the plugin), pixelay_state.glsl and Sampler0, GameTime,
// ScreenSize.

// Sprite index that draws nothing (the cursor is hidden).
#define PIXELAY_HIDDEN_SPRITE 7

// Whether Sampler0 is Pixelay's atlas (not another pack's water overlay): its size and a marker pixel.
bool pixelay_atlas() {
    if (textureSize(Sampler0, 0) != ivec2(int(PIXELAY_ATLAS_SIZE))) {
        return false;
    }
    ivec4 marker = ivec4(texelFetch(Sampler0, ivec2(int(PIXELAY_ATLAS_SIZE) - 1), 0) * 255.0 + 0.5);
    return marker == ivec4(PIXELAY_MARKER);
}

// The normal water overlay (a tile of the atlas), for players in real water.
vec4 pixelay_water(vec2 uv) {
    vec2 origin = vec2(mod(PIXELAY_WATER_CELL, PIXELAY_COLUMNS), floor(PIXELAY_WATER_CELL / PIXELAY_COLUMNS));
    return texture(Sampler0, (origin * PIXELAY_CELL + fract(uv) * PIXELAY_CELL) / PIXELAY_ATLAS_SIZE);
}

// Where the look points on the screen, in screen px from the bottom-left (clamped to the screen).
vec2 pixelay_look_point(vec2 look, float halfHeight, vec2 screen) {
    // Relative to the camera, which looks along yaw 0 and pitch 0.
    float yaw = radians(mod(look.x + 180.0, 360.0) - 180.0);
    float pitch = radians(look.y);
    float forward = cos(yaw);
    vec2 tangent = vec2(
        forward > 1.0e-4 ? tan(yaw) : sign(yaw) * 1.0e4,
        -tan(pitch) / max(forward, 1.0e-4)
    );
    float aspect = screen.x / max(screen.y, 1.0);
    vec2 ndc = clamp(vec2(tangent.x / (halfHeight * aspect), tangent.y / halfHeight), -1.0, 1.0);
    return (ndc * 0.5 + 0.5) * screen;
}

// The sprite's colour over this fragment: the texels it covers, weighted by area (smooth at any scale).
vec4 pixelay_sprite(int sprite, vec2 texel, float texelsPerPixel) {
    vec4 info = PIXELAY_SPRITES[sprite];
    ivec2 origin = ivec2(sprite % int(PIXELAY_COLUMNS), sprite / int(PIXELAY_COLUMNS)) * int(PIXELAY_CELL);
    vec2 from = texel - 0.5 * texelsPerPixel;
    vec2 to = texel + 0.5 * texelsPerPixel;
    vec4 sum = vec4(0.0);
    for (int dy = 0; dy < 4; dy++) {
        float y = floor(from.y) + float(dy);
        if (y >= to.y) {
            break;
        }
        float coverY = min(to.y, y + 1.0) - max(from.y, y);
        for (int dx = 0; dx < 4; dx++) {
            float x = floor(from.x) + float(dx);
            if (x >= to.x) {
                break;
            }
            if (x < 0.0 || y < 0.0 || x >= info.x || y >= info.y) {
                continue;
            }
            float cover = (min(to.x, x + 1.0) - max(from.x, x)) * coverY;
            vec4 s = texelFetch(Sampler0, origin + ivec2(int(x), int(y)), 0);
            sum += vec4(s.rgb * s.a, s.a) * cover;
        }
    }
    sum /= texelsPerPixel * texelsPerPixel;
    return sum.a > 0.0 ? vec4(sum.rgb / sum.a, sum.a) : vec4(0.0);
}

// The cursor over this fragment, or false where it draws nothing.
bool pixelay_cursor(vec2 look, int state, vec2 screen, out vec4 color) {
    color = vec4(0.0);
    int sprite = pixelay_sprite(state);
    if (sprite == PIXELAY_HIDDEN_SPRITE || sprite >= PIXELAY_SPRITE_COUNT) {
        return false;
    }
    vec2 hotSpot = pixelay_look_point(look, pixelay_half_height(pixelay_level(state)), screen);
    // Screen px per sprite px: the sprites are sized for a 1080 px tall screen.
    float pixel = PIXELAY_CURSOR_SCALE * screen.y / 1080.0;
    vec4 info = PIXELAY_SPRITES[sprite];
    // Sprite px from the sprite's top-left (y down), the hot spot on the pointed point.
    vec2 texel = vec2(gl_FragCoord.x - hotSpot.x, hotSpot.y - gl_FragCoord.y) / pixel + info.zw;
    if (texel.x < -1.0 || texel.y < -1.0 || texel.x > info.x + 1.0 || texel.y > info.y + 1.0) {
        return false;
    }
    color = pixelay_sprite(sprite, texel, 1.0 / pixel);
    return color.a > 0.0;
}
